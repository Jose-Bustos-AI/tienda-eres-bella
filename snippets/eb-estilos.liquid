{% doc %}
  Dueño de los estilos compartidos de las secciones "eb-" de Eres Bella
  (contenedor, antetítulo, títulos, botones, enlaces y cabecera de sección).
  No pinta nada: solo hace que su hoja de estilos entre en la página.

  @example
  {% render 'eb-estilos' %}
{% enddoc %}

{% stylesheet %}
  .eb-wrap {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 56px);
  }

  .eb-eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-subheading--family);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #a65f43;
  }

  .eb-h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #2e2a24;
  }

  .eb-lead {
    margin: 16px 0 0;
    max-width: 56ch;
    font-size: 1.05rem;
    line-height: 1.65;
    color: #5b5348;
  }

  .eb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 30px;
    border: 1px solid #2e2a24;
    border-radius: 999px;
    background: #2e2a24;
    color: #faf6ef;
    font-family: var(--font-subheading--family);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .eb-btn:hover {
    background: #a65f43;
    border-color: #a65f43;
    color: #fff;
    transform: translateY(-1px);
  }

  .eb-btn:focus-visible,
  .eb-link:focus-visible {
    outline: 2px solid #a65f43;
    outline-offset: 3px;
  }

  .eb-btn--ghost {
    background: transparent;
    color: #2e2a24;
  }

  .eb-btn--light {
    background: #faf6ef;
    border-color: #faf6ef;
    color: #2e2a24;
  }

  .eb-section {
    padding-block: clamp(56px, 8vw, 112px);
  }

  .eb-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .eb-link {
    font-family: var(--font-subheading--family);
    font-size: 0.92rem;
    color: #2e2a24;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .eb-link:hover {
    color: #a65f43;
  }

  @media (prefers-reduced-motion: reduce) {
    .eb-btn {
      transition: none;
    }

    .eb-btn:hover {
      transform: none;
    }
  }
{% endstylesheet %}
