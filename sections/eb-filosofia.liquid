{% comment %}
  Section contract.
  Bloque de marca en fondo oscuro: imagen a un lado, texto y lista de puntos al otro.
{% endcomment %}

{%- render 'eb-estilos' -%}

<div class="eb-filosofia">
  <div class="eb-wrap eb-filosofia__grid">
    <div class="eb-filosofia__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'eb-filosofia__img',
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image.alt
          | default: section.settings.heading
        }}
      {%- endif -%}
    </div>
    <div class="eb-filosofia__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eb-eyebrow eb-filosofia__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="eb-h2 eb-filosofia__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="eb-filosofia__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="eb-filosofia__list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title | escape }}</strong>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="eb-btn eb-btn--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .eb-filosofia {
    background: #3b4636;
    color: #f3ece0;
    padding-block: clamp(56px, 8vw, 112px);
  }

  .eb-filosofia__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 88px);
    align-items: center;
  }

  .eb-filosofia__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 26px;
    background: #2f382b;
  }

  .eb-filosofia__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eb-filosofia .eb-filosofia__eyebrow {
    color: #d9b79a;
  }

  .eb-filosofia .eb-filosofia__title {
    color: #faf6ef;
  }

  .eb-filosofia__text {
    margin: 18px 0 0;
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #dcd5c6;
  }

  .eb-filosofia__list {
    display: grid;
    gap: 0;
    margin: 28px 0 32px;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(243 236 224 / 0.22);
  }

  .eb-filosofia__list li {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid rgb(243 236 224 / 0.22);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .eb-filosofia__list strong {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.2rem;
    color: #faf6ef;
  }

  .eb-filosofia__list span {
    color: #dcd5c6;
  }

  @media (max-width: 989px) {
    .eb-filosofia__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .eb-filosofia__media {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "EB · Filosofía de marca",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestra filosofía" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Menos ingredientes, mejor elegidos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Cuenta aquí cómo trabaja la marca." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Descubre la colección" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Punto",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Aloe vera" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Calma e hidrata." }
      ]
    }
  ],
  "presets": [{ "name": "EB · Filosofía de marca", "blocks": [{ "type": "punto" }, { "type": "punto" }, { "type": "punto" }] }]
}
{% endschema %}
