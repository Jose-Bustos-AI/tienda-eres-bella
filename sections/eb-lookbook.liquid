{% comment %}
  Section contract.
  Mosaico editorial: cuatro productos de una colección en una rejilla asimétrica,
  con una pieza grande y el nombre y el precio sobre cada foto.
{% endcomment %}

{%- render 'eb-estilos' -%}

{%- assign coleccion = section.settings.collection -%}

<div class="eb-section eb-lookbook">
  <div class="eb-wrap">
    <div class="eb-lookbook__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eb-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="eb-h2">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %}
            <em>{{ section.settings.heading_accent | escape }}</em>
          {%- endif -%}
        </h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="eb-lead eb-lookbook__lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if coleccion != blank and coleccion.products_count > 0 -%}
      <ul class="eb-lookbook__grid" role="list">
        {%- for product in coleccion.products limit: 4 offset: section.settings.offset -%}
          {%- assign alt_foto = product.featured_image.alt | default: product.title -%}
          <li class="eb-lookbook__item eb-lookbook__item--{{ forloop.index }} eb-reveal">
            <a class="eb-lookbook__link" href="{{ product.url }}">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'eb-lookbook__img',
                    loading: 'lazy',
                    widths: '400, 600, 900, 1400',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    alt: alt_foto
                }}
              {%- endif -%}
              <span class="eb-lookbook__shade" aria-hidden="true"></span>
              <span class="eb-lookbook__caption">
                <span class="eb-lookbook__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
                <span class="eb-lookbook__title">{{ product.title | escape }}</span>
                <span class="eb-lookbook__price">{{ product.price | money }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="eb-lead">Elige una colección con productos en los ajustes de esta sección.</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .eb-lookbook {
    background: #faf6ef;
  }

  .eb-lookbook__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(20px, 5vw, 80px);
    align-items: end;
    margin-bottom: clamp(28px, 4vw, 52px);
  }

  .eb-lookbook__head em {
    display: block;
    font-style: italic;
    color: #a65f43;
  }

  .eb-lookbook__lead {
    margin: 0;
  }

  .eb-lookbook__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    grid-template-rows: repeat(2, clamp(210px, 25vw, 340px));
    gap: clamp(10px, 1.4vw, 18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eb-lookbook__item {
    min-width: 0;
    min-height: 0;
  }

  .eb-lookbook__item--1 {
    grid-row: 1 / span 2;
  }

  .eb-lookbook__item--4 {
    grid-column: 2 / span 2;
  }

  .eb-lookbook__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 22px;
    background: #e7dccb;
    color: #fff;
    text-decoration: none;
  }

  .eb-lookbook__link:focus-visible {
    outline: 2px solid #a65f43;
    outline-offset: 3px;
  }

  .eb-lookbook__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .eb-lookbook__link:hover .eb-lookbook__img {
    transform: scale(1.05);
  }

  .eb-lookbook__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(30 26 20 / 0.66) 0%, rgb(30 26 20 / 0) 48%);
  }

  .eb-lookbook__caption {
    position: absolute;
    right: 20px;
    bottom: 18px;
    left: 20px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
  }

  .eb-lookbook__num {
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    opacity: 0.85;
  }

  .eb-lookbook__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
    line-height: 1.15;
  }

  .eb-lookbook__price {
    font-family: var(--font-subheading--family);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 749px) {
    .eb-lookbook__head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .eb-lookbook__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: auto;
    }

    .eb-lookbook__item--1,
    .eb-lookbook__item--4 {
      grid-row: auto;
      grid-column: 1 / -1;
    }

    .eb-lookbook__link {
      aspect-ratio: 4 / 5;
    }

    .eb-lookbook__item--1 .eb-lookbook__link {
      aspect-ratio: 1 / 1;
    }

    .eb-lookbook__item--4 .eb-lookbook__link {
      aspect-ratio: 16 / 10;
    }

    .eb-lookbook__caption {
      right: 12px;
      bottom: 12px;
      left: 12px;
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .eb-lookbook__num {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eb-lookbook__img {
      transition: none;
    }

    .eb-lookbook__link:hover .eb-lookbook__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "EB · Mosaico editorial",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Para el cuerpo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Después de la ducha," },
    { "type": "text", "id": "heading_accent", "label": "Final del título destacado", "default": "sin prisas" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Aceites, mantecas y jabones para cuidar la piel de todo el cuerpo." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "offset", "label": "Saltar los primeros productos", "min": 0, "max": 8, "step": 1, "default": 0 }
  ],
  "presets": [{ "name": "EB · Mosaico editorial" }]
}
{% endschema %}
